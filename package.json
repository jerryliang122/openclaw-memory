{
  "name": "openclaw-memory",
  "version": "0.1.0",
  "description": "Persistent, file-backed long-term memory tools for OpenClaw agents",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "scripts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "assets": "node scripts/make-icon.mjs",
    "install:host": "node scripts/install-host.mjs",
    "verify:host": "npm run install:host && tsc -p tsconfig.host.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "1.3.33"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.35"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "agent-tools"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.35",
      "minGatewayVersion": "2026.6.35"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  }
}
